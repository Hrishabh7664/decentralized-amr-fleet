    </model>

    <!-- Storage Racks - Aisle Set 2 (East) -->
    <model name="rack_row_5">
      <static>true</static>
      <pose>8 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_6">
      <static>true</static>
      <pose>8 2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_7">
      <static>true</static>
      <pose>8 -2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_8">
      <static>true</static>
      <pose>8 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 1.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
