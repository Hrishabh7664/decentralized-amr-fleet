        </visual>
      </link>
    </model>

    <!-- Narrow Center Bottleneck / Choke Point Barrier -->
    <model name="choke_barrier_north">
      <static>true</static>
      <pose>0 3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.0 4.0 1.2</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.0 4.0 1.2</size></box></geometry>
          <material><ambient>0.9 0.9 0.2 1</ambient><diffuse>1.0 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="choke_barrier_south">
      <static>true</static>
      <pose>0 -3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.0 4.0 1.2</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.0 4.0 1.2</size></box></geometry>
          <material><ambient>0.9 0.9 0.2 1</ambient><diffuse>1.0 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging Station Markers -->
    <model name="dock_station_nw">
      <static>true</static>
      <pose>-12 8 0.02 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.2 1.2 0.04</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dock_station_sw">
      <static>true</static>
      <pose>-12 -8 0.02 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.2 1.2 0.04</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.9 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -18 20 0 0.85 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
