<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_world">
    <!-- Physics parameters: 1 kHz update rate with 1ms step size -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Lighting: Inline directional sun light to avoid remote model fetching -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor Ground Plane with High Friction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <collide_bitmask>0xffff</collide_bitmask>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Outer Perimeter Walls -->
    <model name="warehouse_outer_walls">
      <static>true</static>
      <!-- North Wall -->
      <link name="north_wall">
        <pose>0 15 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>30 0.4 3</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.4 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <!-- South Wall -->
      <link name="south_wall">
        <pose>0 -15 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>30 0.4 3</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.4 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <!-- East Wall -->
      <link name="east_wall">
        <pose>15 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.4 30 3</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <!-- West Wall -->
      <link name="west_wall">
        <pose>-15 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.4 30 3</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Racks - Aisle Set 1 (West) -->
    <model name="rack_row_1">
      <static>true</static>
      <pose>-8 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_2">
      <static>true</static>
      <pose>-8 2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_3">
      <static>true</static>
      <pose>-8 -2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_4">
      <static>true</static>
      <pose>-8 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Racks - Aisle Set 2 (East) -->
    <model name="rack_row_5">
      <static>true</static>
      <pose>8 6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_6">
      <static>true</static>
      <pose>8 2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_7">
      <static>true</static>
      <pose>8 -2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.9 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_row_8">
      <static>true</static>
      <pose>8 -6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 1.2 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0xffff</collide_bitmask></contact>
